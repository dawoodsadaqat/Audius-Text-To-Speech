{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Audius",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:default",
    "dialog:allow-save",

    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",

    "opener:default",

    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn"
  ]
}